# Flutter / Dart generated output
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
*.iml
.idea/
.vscode/
**/*.g.dart

# Native platforms are created using scripts/bootstrap.sh for MVP stage.
# Once generated projects are reviewed, commit their configuration in a
# dedicated platform-integration PR.
# Ignore generated Android files, but keep the hand-written R8 rules: release
# builds need them for ML Kit receipt scanning, and flutter create keeps it.
android/*
!android/app/
android/app/*
!android/app/proguard-rules.pro
ios/
linux/
macos/
windows/
web/
.metadata

# Licensed font binaries are fetched and SHA-verified during bootstrap.
assets/fonts/*.ttf
